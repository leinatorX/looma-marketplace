{
  "$schema": "https://looma.dev/schemas/acp-agent.v1.json",
  "id": "antigravity",
  "displayName": "Antigravity (ACP)",
  "binary": {
    "name": "agy",
    "windowsCandidates": [
      "%LOCALAPPDATA%\\agy\\bin\\agy.exe",
      "%USERPROFILE%\\.local\\bin\\agy.exe"
    ],
    "unixCandidates": [
      "~/.local/bin/agy",
      "/usr/local/bin/agy"
    ]
  },
  "acpArgs": [
    "acp"
  ],
  "minVersion": "1.5.1",
  "versionFlag": "--version",
  "versionRegex": "(?:agy(?:\\.exe)?|version)\\s*v?([0-9]+\\.[0-9]+\\.[0-9]+)",
  "modelsCommand": "models",
  "updateArgs": [
    "update"
  ],
  "loginArgs": [
    "login"
  ],
  "installHint": "访问官方网站下载安装 agy 命令行工具并执行 agy login 登录",
  "env": {}
}
