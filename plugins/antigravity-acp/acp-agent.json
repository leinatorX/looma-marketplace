{
  "$schema": "https://looma.dev/schemas/acp-agent.v1.json",
  "schemaVersion": 1,
  "id": "antigravity",
  "displayName": "Antigravity (ACP)",
  "binary": {
    "name": "agy",
    "windowsPaths": [
      "%LOCALAPPDATA%/agy/bin/agy.exe",
      "%USERPROFILE%/.local/bin/agy.exe"
    ],
    "unixPaths": [
      "~/.local/bin/agy",
      "/opt/homebrew/bin/agy",
      "/usr/local/bin/agy"
    ]
  },
  "acpArgs": [
    "acp"
  ],
  "minVersion": "1.5.1",
  "requireHelpSubcommand": "acp",
  "modelsCommand": {
    "args": [
      "models"
    ],
    "format": "tsv"
  },
  "updateArgs": [
    "update"
  ],
  "loginArgs": [
    "login"
  ],
  "supportsAntigravitySystemPrompt": true,
  "installHint": "访问官方网站下载安装 agy 命令行工具并执行 agy login 登录"
}
